# Copy to .env. Never commit real credentials.
DATABASE_URL=postgresql://contexa:contexa@localhost:5432/contexa
PORT=4000
HOST=127.0.0.1
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# Exact HTTPS origin in production (no trailing slash/path).
PUBLIC_ORIGIN=
# Number of trusted reverse-proxy hops; leave 0 locally.
TRUST_PROXY_HOPS=0
# Leave blank for the same-origin production API; Vite proxies /api locally.
VITE_API_BASE=
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=
DISCORD_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
CONTEXA_API_URL=http://127.0.0.1:4000
DISCORD_TRACKED_CHANNELS=

# Optional deployment encryption key: 64 hexadecimal characters.
# Leave empty for a locally generated .local/secrets.key (back it up).
CONTEXA_SECRET_KEY=

# Optional private inference service; leave blank to use the local default.
CONTEXA_ML_URL=http://127.0.0.1:5001

# Optional recovery email. Requires a verified sender and PUBLIC_ORIGIN HTTPS.
# Leave blank to keep recovery unavailable; no email is sent without configuration.
RESEND_API_KEY=
RECOVERY_FROM_EMAIL=
